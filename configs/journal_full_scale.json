{
  "seed": 17,
  "output_root": "artifacts/journal_full_scale",
  "dataset_root": "artifacts/journal_full_scale",
  "device": "auto",
  "image_size": [200, 80],
  "captcha_length": 5,
  "characters": "23456789ABCDEFGHJKLMNPQRSTUVWXYZ",
  "difficulties": ["clean", "easy", "medium", "hard"],
  "train_difficulty": "medium",
